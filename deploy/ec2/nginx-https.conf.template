log_format iipa_safe '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    server_tokens off;
    access_log /var/log/nginx/iipa-access.log iipa_safe;
    error_log /dev/null emerg;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; default_type text/plain; }
    location / { return 308 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __HOST__;
    server_tokens off;
    ssl_certificate __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/iipa/current/apps/web/dist;
    index index.html;
    client_max_body_size 32k;
    access_log /var/log/nginx/iipa-access.log iipa_safe;
    error_log /dev/null emerg;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Strict-Transport-Security 'max-age=86400' always;
    location ^~ /api/ {
        # No URI suffix: preserve /api/v1/... exactly, including OAuth callback.
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_read_timeout 30s;
        proxy_redirect off;
    }
    location = /health { proxy_pass http://127.0.0.1:3001/health; }
    location = /ready { proxy_pass http://127.0.0.1:3001/ready; }
    location ~ /\. { deny all; }
    location /assets/ { try_files $uri =404; expires 7d; }
    location = /index.html { expires -1; }
    location / { try_files $uri $uri/ /index.html; }
}
