{
    "name":  "@ifms/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "test":  "tsx --test test/*.test.ts",
                    "test:db":  "tsx --test --test-concurrency=1 test/integration/*.test.ts",
                    "db:migrate":  "tsx src/db/migrate.ts",
                    "db:seed":  "tsx src/db/seed.ts",
                    "db:admin":  "tsx src/db/set-admin.ts"
                },
    "dependencies":  {
                         "cookie-parser":  "1.4.7",
                         "cors":  "2.8.6",
                         "decimal.js":  "10.6.0",
                         "express":  "5.2.1",
                         "express-rate-limit":  "8.7.1",
                         "google-auth-library":  "11.2.0",
                         "helmet":  "8.3.0",
                         "pg":  "8.23.1",
                         "zod":  "4.6.5"
                     },
    "devDependencies":  {
                            "@types/cookie-parser":  "1.4.10",
                            "@types/cors":  "2.8.19",
                            "@types/express":  "5.0.6",
                            "@types/pg":  "8.23.1"
                        }
}
